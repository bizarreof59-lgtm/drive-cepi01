<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stay & Home - Imóveis</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #f7f7f7; color: #222; }
    header { background: #fff; padding: 20px 40px; border-bottom: 1px solid #e0e0e0; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
    .logo { font-size: 24px; font-weight: bold; color: #ff385c; }
    .nav-tabs { display: flex; gap: 10px; }
    .tab-btn { padding: 10px 20px; border: 1px solid #ddd; background: #fff; border-radius: 20px; cursor: pointer; font-weight: 600; }
    .tab-btn.active { background: #ff385c; color: #fff; border-color: #ff385c; }
    .search-container { max-width: 1100px; margin: 30px auto 10px; padding: 0 20px; }
    .search-bar { display: flex; gap: 10px; background: #fff; padding: 10px; border-radius: 30px; box-shadow: 0 3px 12px rgba(0,0,0,0.1); }
    .search-bar input { flex: 1; border: none; outline: none; padding: 10px 15px; font-size: 16px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; max-width: 1100px; margin: 30px auto; padding: 0 20px; }
    .card { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); transition: transform 0.2s; cursor: pointer; }
    .card:hover { transform: translateY(-4px); }
    .card img { width: 100%; height: 200px; object-fit: cover; }
    .card-body { padding: 16px; }
    .tag { display: inline-block; padding: 4px 8px; font-size: 12px; border-radius: 4px; font-weight: bold; margin-bottom: 8px; }
    .tag.venda { background: #e3f2fd; color: #0d47a1; }
    .tag.aluguel { background: #e8f5e9; color: #1b5e20; }
    .card-title { font-size: 18px; font-weight: bold; margin-bottom: 6px; }
    .card-location { font-size: 14px; color: #666; margin-bottom: 10px; }
    .card-price { font-size: 16px; font-weight: bold; color: #ff385c; }
  </style>
</head>
<body>

  <header>
    <div class="logo">🏠 HomeFinder</div>
    <div class="nav-tabs">
      <button class="tab-btn active" onclick="filterModalidade('todos', event)">Todos</button>
      <button class="tab-btn" onclick="filterModalidade('venda', event)">Comprar</button>
      <button class="tab-btn" onclick="filterModalidade('aluguel', event)">Alugar</button>
    </div>
  </header>

  <div class="search-container">
    <div class="search-bar">
      <input type="text" id="searchInput" placeholder="Busque por cidade, bairro ou tipo de imóvel..." onkeyup="filterImoveis()">
    </div>
  </div>

  <div class="grid" id="propertyGrid"></div>

  <script>
    const imoveis = [
      { id: 1, titulo: "Apartamento Moderno no Centro", tipo: "venda", local: "São Paulo, SP", preco: "R$ 650.000", img: "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=500" },
      { id: 2, titulo: "Casa de Luxo com Piscina", tipo: "venda", local: "Rio de Janeiro, RJ", preco: "R$ 1.850.000", img: "https://images.unsplash.com/photo-1613977257363-707ba9348227?w=500" },
      { id: 3, titulo: "Studio Aconchegante perto do Metrô", tipo: "aluguel", local: "Curitiba, PR", preco: "R$ 2.200 / mês", img: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=500" },
      { id: 4, titulo: "Cobertura Duplex com Vista para o Mar", tipo: "aluguel", local: "Florianópolis, SC", preco: "R$ 5.500 / mês", img: "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=500" }
    ];

    let currentFilter = 'todos';

    function renderProperties(list) {
      const container = document.getElementById('propertyGrid');
      container.innerHTML = list.map(item => `
        <div class="card">
          <img src="${item.img}" alt="${item.titulo}">
          <div class="card-body">
            <span class="tag ${item.tipo}">${item.tipo === 'venda' ? 'Venda' : 'Aluguel'}</span>
            <div class="card-title">${item.titulo}</div>
            <div class="card-location">${item.local}</div>
            <div class="card-price">${item.preco}</div>
          </div>
        </div>
      `).join('');
    }

    function filterModalidade(tipo, event) {
      currentFilter = tipo;
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');
      filterImoveis();
    }

    function filterImoveis() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const filtered = imoveis.filter(item => {
        const matchesType = currentFilter === 'todos' || item.tipo === currentFilter;
        const matchesSearch = item.titulo.toLowerCase().includes(query) || item.local.toLowerCase().includes(query);
        return matchesType && matchesSearch;
      });
      renderProperties(filtered);
    }

    renderProperties(imoveis);
  </script>

</body>
</html>